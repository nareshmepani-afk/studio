rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only read and write to their own user document.
    match /users/{userId} {
      allow read, write, create: if request.auth.uid == userId;
    }

    // Users can only read and write their own memories.
    match /users/{userId}/memories/{memoryId} {
      allow read, write: if request.auth.uid == userId;
    }
  }
}
