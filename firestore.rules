
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow any authenticated user to connect to and control a studio session.
    // This is secure because the sessionId is a unique, unguessable string
    // shared only between a user's own devices for a short-lived session.
    match /studio/{sessionId} {
      allow read, write: if request.auth != null;
    }

    // Users can only manage their own user document. 
    // Public read allowed for Cinema attribution (Director names).
    match /users/{userId} {
      allow read: if true;
      allow write, create: if request.auth.uid == userId;
    }

    // Anyone can list and read memories (public Cinema).
    match /users/{userId}/memories {
      allow read, list: if true;
    }

    // Allow any authenticated user (including anonymous guests) to read a memory.
    // This allows the public Cinema gallery to function.
    match /users/{userId}/memories/{memoryId} {
      allow read: if true;
      allow write: if request.auth.uid == userId;

      // Allow users to read their own narrative analysis subdocuments
      match /analysis/{docId} {
        allow read: if request.auth.uid == userId;
      }
    }

    // Story Requests (Recursive match covers collection list and doc read/write)
    match /users/{userId}/requests/{requestId=**} {
      allow read, write: if request.auth.uid == userId;
      allow create: if true;
    }
  }
}
