rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow any authenticated user to connect to and control a studio session.
    // This is secure because the sessionId is a unique, unguessable string
    // shared only between a user's own devices for a short-lived session.
    match /studio/{sessionId} {
      allow read, write: if request.auth != null;
    }

    // Users can only manage their own user document.
    // Public read allowed for Cinema attribution (Director names).
    match /users/{userId} {
      allow read: if true;
      allow write, create: if request.auth != null && request.auth.uid == userId;
    }

    // Fireside Voice Studio Drafts (Milestone MW-87 / Ticket #248)
    match /users/{userId}/firesideDrafts/{draftId=**} {
      allow read, write, create, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Chamber II: Living Chronicles Private Diary Studio (RFC-MW-156 / AUDIT-MW-147 / MW-378)
    // Strictly owner-private for both reads and writes (never exposed to public Cinema).
    match /users/{userId}/chronicles/{logId=**} {
      allow read, write, create, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Anyone can list and read memories (public Cinema).
    match /users/{userId}/memories {
      allow read, list: if true;
    }

    // Allow any authenticated user (including anonymous guests) to read a memory.
    // This allows the public Cinema gallery to function.
    match /users/{userId}/memories/{memoryId} {
      allow read: if true;
      allow write: if request.auth.uid == userId;

      // Allow users to read their own narrative analysis subdocuments
      match /analysis/{docId} {
        allow read: if request.auth.uid == userId;
      }
    }

    // Story Requests (Recursive match covers collection list and doc read/write)
    match /users/{userId}/requests/{requestId=**} {
      allow read, write, create: if request.auth != null && request.auth.uid == userId;
    }

    // System Logs read access for MFA-verified administrators only (MW-403)
    match /system_logs/{logId} {
      allow read: if request.auth != null && request.auth.token.isAdmin == true;
    }

    // Gift Vouchers — all operations via Admin SDK (server-side only).
    // Client-side access is denied; all reads/writes go through API endpoints.
    match /gift_vouchers/{voucherCode} {
      allow read, write: if false;
    }

    // QA Suite & Active Testing Deck — admin-only (Option A routes /admin/qa via Admin SDK; MW-404)
    match /qa_suites/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.token.isAdmin == true;
    }

    // In-App Bug Reports Triage Queue — persisted via Server Action (Admin SDK), managed by admins only
    match /bug_reports/{reportId} {
      allow read, write: if request.auth != null && request.auth.token.isAdmin == true;
    }

    // Pre-Launch Access Mode & Unified Tester/Waitlist Registry — Admin SDK & admins only
    match /prelaunch_config/{docId} {
      allow read, write: if request.auth != null && request.auth.token.isAdmin == true;
    }
    match /prelaunch_list/{emailKey} {
      allow read, write: if request.auth != null && request.auth.token.isAdmin == true;
    }

    // Interactive Founder Cutover Decision Queue — managed via Admin Hub & CLI
    match /founder_decisions/{id} {
      allow read, write: if request.auth != null && request.auth.token.isAdmin == true;
    }

    // Founder Release & Batch Gatekeeper Controls — Staging Control Plane & CLI only
    match /release_controls/{id} {
      allow read, write: if request.auth != null && request.auth.token.isAdmin == true;
    }
  }
}
