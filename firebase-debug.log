[debug] [2026-01-27T14:41:28.145Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-app:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"\nrules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // Allow any authenticated user to connect to and control a studio session.\n    // This is secure because the sessionId is a unique, unguessable string\n    // shared only between a user's own devices for a short-lived session.\n    match /studio/{sessionId} {\n      allow read, write: if request.auth != null;\n    }\n\n    // Users can only read, write, and create their own user document.\n    match /users/{userId} {\n      allow read, write, create: if request.auth.uid == userId;\n    }\n\n    // Users can only read and write their own memories.\n    match /users/{userId}/memories/{memoryId} {\n      allow read, write: if request.auth.uid == userId;\n    }\n  }\n}\n"}]}}
