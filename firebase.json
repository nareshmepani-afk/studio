{
  "hosting": {
    "public": "public",  // <--- ADDED THIS LINE
    "ignore": [          // <--- ADDED THIS SECTION
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cross-Origin-Embedder-Policy",
            "value": "require-corp"
          },
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin"
          }
        ]
      }
    ]
  },
  "apphosting": {
    "memory-weaver-8rk9t": {
      "location": "us-central1"
    }
  }
}
