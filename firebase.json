
{
  "apphosting": {
    "backend": "nextn",
    "headers": [
      {
        "source": "/**",
        "headers": [
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin"
          },
          {
            "key": "Cross-origin-Embedder-Policy",
            "value": "require-corp"
          }
        ]
      }
    ]
  },
  "functions": {
    "source": "functions"
  }
}
