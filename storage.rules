rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // User Avatars
    // Users can read anyone's avatar.
    // Users can only write (upload/delete) their own avatar.
    match /avatars/{userId}/{imageName} {
      allow read;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Memory Media
    // Users can read and write their own memory media.
    match /memories/{userId}/{mediaName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}