
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow users to read, write, and delete files if they are authenticated.
    // This is a broader rule to troubleshoot permission issues.
    // The app logic should still enforce that users only write to their own folders.
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
