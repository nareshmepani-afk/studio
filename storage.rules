
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow all reads and writes from any user, authenticated or not.
    // This is an insecure rule and is only used as a last resort to
    // bypass a persistent client-side authentication issue.
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}
