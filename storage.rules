rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // User-specific files, including media attachments for memories.
    // Public cinema playback handles global read-access safely.
    // Write and delete enforce strict tenant isolation for authenticated users.
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write, delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
