
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow users to read their own files.
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }

    // A more secure rule for writing:
    // 1. The user must be authenticated.
    // 2. The path must match their user ID.
    // 3. The uploaded resource must have custom metadata where `userId` matches their UID.
    // This server-side check prevents users from uploading files to other users' folders
    // even if the client-side code is compromised.
    match /users/{userId}/{allPaths=**} {
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.metadata.userId == request.auth.uid;
    }
  }
}
