
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow users to read, write, and delete files in their own folder.
    // The {userId} wildcard captures the user's ID from the path.
    // request.auth.uid is the ID of the currently authenticated user.
    // This rule ensures that users can only access their own files.
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
